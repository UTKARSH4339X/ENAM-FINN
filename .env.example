# Copy to .env.local for local development (never commit secrets).

# Optional: Python FastAPI origin for full research / filings / grounded Ask.
# Leave unset locally to use http://127.0.0.1:8000 automatically in development.
# On Vercel, set this to your hosted API HTTPS URL (Render / Railway / Fly).
# If unset in production, Next still serves live quotes + NSE search via embedded handlers.
FINN_API_ORIGIN=https://your-finn-api.example.com

# Next.js public site URL (optional; used by some hosts)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
